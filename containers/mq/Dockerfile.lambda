ARG BASE_IMAGE=public.ecr.aws/lambda/python:3.12-x86_64

FROM ${BASE_IMAGE}

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy workspace packages (built from repo root)
COPY containers/base/pyproject.toml /tmp/mmc-base/
COPY containers/base/src/ /tmp/mmc-base/src/
COPY containers/mq/pyproject.toml ./
COPY containers/mq/src/ ./src/

# Install workspace dependencies first
RUN pip install --no-cache-dir /tmp/mmc-base/ && pip install --no-cache-dir .

ENV MMC_ANALYSER_MODULE=analyser_mq.analyser:MqAnalyser
