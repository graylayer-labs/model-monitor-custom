ARG BASE_IMAGE=public.ecr.aws/lambda/python:3.12-x86_64

FROM ${BASE_IMAGE}

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy all workspace packages (built from repo root for full context)
COPY containers/base/ /tmp/mmc-base/
COPY containers/mq/ ./

# Install base workspace dependency first, then this package
RUN pip install --no-cache-dir /tmp/mmc-base/ && pip install --no-cache-dir .

ENV MMC_ANALYSER_MODULE=analyser_mq.analyser:MqAnalyser
